[
  {"name": "weekday of a future date", "args": {"operation": "describe", "date": "2031-03-12"},
   "expect": {"weekday": "среда"}},
  {"name": "days until new year", "args": {"operation": "between", "date": "2026-10-14", "other_date": "2027-01-01"},
   "expect": {"days": 79}},
  {"name": "age-style breakdown", "args": {"operation": "between", "date": "1998-07-20", "other_date": "2026-10-14"},
   "expect": {"breakdown.years": 28, "breakdown.months": 2, "breakdown.days": 24}},
  {"name": "month end is clamped", "args": {"operation": "between", "date": "2024-01-31", "other_date": "2024-03-01"},
   "expect": {"breakdown.years": 0, "breakdown.months": 1, "breakdown.days": 1}},
  {"name": "backwards interval is negative", "args": {"operation": "between", "date": "2026-10-14", "other_date": "2026-10-04"},
   "expect": {"days": -10, "breakdown.days": -10}},
  {"name": "two working weeks", "args": {"operation": "between", "date": "2026-10-12", "other_date": "2026-10-26"},
   "expect": {"weekdays_mon_fri": 10}},
  {"name": "shift forward", "args": {"operation": "shift", "date": "2026-10-14", "days": 90, "language": "en"},
   "expect": {"date": "2027-01-12", "weekday": "Tuesday"}},
  {"name": "facts about a date", "args": {"operation": "describe", "date": "2026-10-14"},
   "expect": {"iso_week": 42, "day_of_year": 287, "days_left_in_year": 78, "leap_year": false}},
  {"name": "invalid date is declined", "args": {"operation": "describe", "date": "2026-02-30"},
   "expect_error": "invalid date"},
  {"name": "missing operand is declined", "args": {"operation": "shift", "date": "2026-10-14"},
   "expect_error": "shift needs days"},
  {"name": "out of range is declined", "args": {"operation": "shift", "date": "9999-12-30", "days": 5},
   "expect_error": "outside years"}
]

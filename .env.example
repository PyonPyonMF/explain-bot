# Copy to .env and fill in. Never commit .env. Comments must be on their own lines.

# Only for the Caddy profile: a DNS A record for this name must point to this server.
DOMAIN=bot.example.com

# Developer Portal -> General Information -> Public Key
DISCORD_PUBLIC_KEY=
# Optional: conversation context (bot in the server + Message Content intent)
DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=xcVbjGhhLIoKi3va6mAe

ANTHROPIC_MODEL=claude-sonnet-5-5
ELEVENLABS_MODEL=eleven_multilingual_v2
DAILY_LIMIT=500
MAX_UPLOAD_MB=9.5
BOT_LANG=ru
DEBUG_ERRORS=1
FULL_GEN=1
REVIEW_ROUNDS=2
MAX_QUEUED_JOBS=4

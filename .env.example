# Copy to .env and fill in. Never commit .env. Comments must be on their own lines.

# Gateway mode (compose.gateway.yml) needs no DOMAIN or DISCORD_PUBLIC_KEY.
# Only for the Caddy profile: a DNS A record for this name must point to this server.
DOMAIN=bot.example.com

# Developer Portal -> General Information -> Public Key
DISCORD_PUBLIC_KEY=
# Required in Gateway mode. Optional in HTTP mode for conversation context.
DISCORD_BOT_TOKEN=
# Register slash/context commands at Gateway startup (server-installed bot).
REGISTER_COMMANDS=1
# Gateway mentions/replies need Bot -> Message Content Intent enabled.
ENABLE_MENTIONS=1
# Ask for a button choice on vague/conflicting requests before spending quota or calling models.
CLARIFY_AMBIGUOUS=1
MENTION_CONTEXT_MESSAGES=10
# Visual assets: web image references + one Codex CLI illustration when it helps.
VISUAL_ASSETS=1
# Full-frame portrait zooms and callouts when explaining an existing image.
IMAGE_WALKTHROUGH=1
WEB_VISUALS=1
# Image search: "auto" = Wikimedia Commons + Openverse (free licenses, no key), plus Brave/SearXNG when set.
# Or an explicit ordered list, e.g. brave,searxng,commons,openverse
IMAGE_SEARCH_PROVIDERS=auto
# Whole-web image search (https://api-dashboard.search.brave.com, free tier available)
BRAVE_SEARCH_API_KEY=
# Your own SearXNG with "json" in search.formats, e.g. http://searxng:8080
SEARXNG_URL=
# Sonnet looks at the found images and keeps only fitting ones (0 = take the first hit)
IMAGE_PICKER=1
# Fact-checking before the script: Sonnet uses Anthropic's server-side web search (same API key).
# Allow web search for your organization in the Anthropic Console. Each search is billed.
WEB_RESEARCH=1
RESEARCH_MAX_SEARCHES=4
# Explicit /research or 'рисерч: ...' mode; hard-bounded, text report with progress.
DEEP_RESEARCH_TIMEOUT=600
DEEP_RESEARCH_MAX_PAGES=48
DEEP_RESEARCH_MAX_SEARCHES=12
RESEARCH_TIMEOUT=150
RESEARCH_EFFORT=medium
CODEX_IMAGES=1
# Photo enhancement ("джарвис enhance", "улучши фото", "раскрась"): the Codex worker restores the attached photo.
# Only the photo (and the colorize flag) is sent; replies are labeled as generated detail. 0 = off.
IMAGE_ENHANCE=1
# Seconds the bot waits for the worker, including a queued job ahead; the worker's own run limit is CODEX_IMAGE_TIMEOUT.
IMAGE_ENHANCE_TIMEOUT=750
# Host worker account UID/GID (the example systemd service runs as coder).
CODEX_VISUAL_UID=1000
CODEX_VISUAL_GID=1000
# Opt-in 3D mode: @bot 3d ... or /explain mode:3d. Models are read-only.
VRM_AVATAR_PATH=/models3d/teacher.vrm
THREED_FPS=8
THREED_WIDTH=960
THREED_HEIGHT=540
THREED_SAMPLES=2
THREED_ENGINE=BLENDER_WORKBENCH
THREED_MAX_SECONDS=60
THREED_RENDER_TIMEOUT=600
# Optional Windows GPU worker. When offline/busy/failing, use the CPU profile above.
THREED_REMOTE=0
THREED_REMOTE_FPS=12
THREED_REMOTE_TIMEOUT=600
THREED_WORKER_UID=1002
THREED_WORKER_GID=1002
OBJECT_LIBRARY_DIR=/library3d
OBJECT_LIBRARY_AUTO_SAVE=1
OBJECT_LIBRARY_MAX_ASSETS=500
OBJECT_LIBRARY_MAX_MB=512
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=xcVbjGhhLIoKi3va6mAe

ANTHROPIC_MODEL=claude-sonnet-5-5
# Cache repeated system instructions across jobs. 1h tolerates gaps between video requests.
# Cache writes have a premium; 5m is an option for short bursts, 0 disables caching.
ANTHROPIC_PROMPT_CACHE=1
ANTHROPIC_CACHE_TTL=1h
ELEVENLABS_MODEL=eleven_multilingual_v2
STT_PROVIDER=auto
TTS_PROVIDER=auto
# Optional private Whisper/Piper service. auto falls back when ElevenLabs is unavailable.
# LOCAL_SPEECH_SOCKET=/speech-socket/speech.sock
# LOCAL_SPEECH_TOKEN=match-the-private-worker-config
# Speech in supplied video/audio uses the existing ElevenLabs key; STT is billed separately.
SPEECH_RECOGNITION=1
ELEVENLABS_STT_MODEL=scribe_v2
SPEECH_MAX_SECONDS=7200
# YouTube downloads audio by default. Video frames require an explicit 'покадрово' request.
YOUTUBE_MEDIA=1
YOUTUBE_MAX_SECONDS=7200
YOUTUBE_CACHE_MB=512
YOUTUBE_CACHE_HOURS=24
# compose.gateway.yml supplies the self-hosted internal provider URL. No host port is published.
YOUTUBE_POT_URL=http://pot:4416
# Capability router, shadow mode: records whether the existing pipeline, a library tool, or a missing capability
# would answer each request (python -m router backlog). It never changes answers. One low-effort routing call per
# request unless Jev decides first; 0 = off.
ROUTER_SHADOW=1
# Jev decisions at or above this confidence skip the Messages API call.
JEV_ROUTER_CONFIDENCE=0.8
ROUTER_EFFORT=low
# Tool forge: the owner (Discord user id) gets a DM card for a missing capability requested FORGE_MIN_REQUESTS
# times in 30 days; Build queues its specification for scripts/tool_forge.py on the host. Empty = off.
FORGE_OWNER_ID=
FORGE_MIN_REQUESTS=2
# Host directory shared with the forge service, and the forge account that must own each job directory.
FORGE_QUEUE_HOST=/var/lib/explain-bot-forge/queue
FORGE_UID=1001
FORGE_GID=1001
# Optional fast routing judge (TypeSafe AI's Jev decision model). Off while the key is empty.
# When on, minimized request text is sent to TypeSafe as a third-party processor; input tokens are billed.
TYPESAFE_API_KEY=
# Empty uses https://api.typesafe.ai. Plain http is accepted only for a localhost mock server.
TYPESAFE_BASE_URL=
# Empty uses jev-latest.
TYPESAFE_DEFAULT_MODEL=
# 0 turns the router off even when the key is set.
JEV_ROUTER=1
# Seconds for one decision, retries included. A slow or failing call gives up instead of waiting.
JEV_TIMEOUT=10
# Cap on the serialized request sent per decision, in characters.
JEV_MAX_STATE_CHARS=24000
DAILY_LIMIT=500
MAX_UPLOAD_MB=9.5
BOT_LANG=ru
DEBUG_ERRORS=1
FULL_GEN=1
REVIEW_ROUNDS=2
MAX_QUEUED_JOBS=4
# Tool library (tools/). compose.gateway.yml sets TOOLS_DIR and the isolated executor socket.
# Seconds between rescans of the tool directory; a merged tool needs only `git pull`.
TOOLS_RESCAN=30
# Above this many active tools, research loads their definitions on demand through the tool search tool.
TOOLS_DEFER_AFTER=8
# A probation tool becomes stable after this many calls with at least 95% answered or declined (0: only by hand).
TOOLS_PROMOTE_AFTER=20
# A tool is suspended after this many consecutive failed calls (0: off), or when over 30% of at least 5 calls failed.
TOOLS_SUSPEND_AFTER_FAILURES=3
# Development only: run tools in this container as the sandbox user, without the network boundary.
# TOOLS_LOCAL_SANDBOX=1
# Restarts (Gateway mode): mention jobs are journaled in DATA_DIR/jobs.sqlite and resume after a restart.
# A job is started at most JOB_MAX_ATTEMPTS times and is not resumed after JOB_RESUME_MAX_AGE seconds.
JOB_MAX_ATTEMPTS=2
JOB_RESUME_MAX_AGE=21600
# On SIGTERM, wait this many seconds for running jobs. Keep below stop_grace_period in compose.gateway.yml.
DRAIN_TIMEOUT=900

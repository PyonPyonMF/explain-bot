[Unit]
Description=Explain bot private render transport
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_render
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config_render
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
